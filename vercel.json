{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://blog-leonardoames.vercel.app/blog"
    },
    {
      "source": "/blog/:path*",
      "destination": "https://blog-leonardoames.vercel.app/blog/:path*"
    },
    {
      "source": "/educacao",
      "destination": "https://mentoria-ames-preview.vercel.app/educacao"
    },
    {
      "source": "/educacao/",
      "destination": "https://mentoria-ames-preview.vercel.app/educacao"
    },
    {
      "source": "/educacao/:path*",
      "destination": "https://mentoria-ames-preview.vercel.app/educacao/:path*"
    }
  ]
}
